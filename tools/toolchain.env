# Shared toolchain definitions. Sourced by tools/setup.sh and the Makefile.
# Edit the pins here; nothing else should hard-code a version or path.

GODOT_VERSION="4.7.2"
GODOT_TAG="${GODOT_VERSION}-stable"
# Godot names the export-template directory with a dot instead of a dash.
GODOT_TEMPLATE_DIR_VERSION="${GODOT_VERSION}.stable"

GODOT_ZIP="Godot_v${GODOT_TAG}_linux.x86_64.zip"
GODOT_TPZ="Godot_v${GODOT_TAG}_export_templates.tpz"
GODOT_RELEASE_BASE="https://github.com/godotengine/godot/releases/download/${GODOT_TAG}"

# SHA512 sums from the release's official SHA512-SUMS.txt manifest.
GODOT_ZIP_SHA512="9aa00f7a605200940bce3027a567b782f49bd8e940dd06ae9e987bd65aee1b1467edd56ed84fcdcbdd44354bf613bdbb4e5d2913e925850368e150c59ed54c65"
GODOT_TPZ_SHA512="ca4d71c4d7b81dfc15d1a98baa07534aa95b03fdda78a0075b06672e1648d2e5f40980c9adc28d23e1b92e732ee7bf3461997aa804af74ec2fcd7a93ccb84079"

CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/godot-flappy/${GODOT_VERSION}"
GODOT_BIN="${CACHE_ROOT}/bin/godot"
DOWNLOAD_DIR="${CACHE_ROOT}/downloads"

# Godot resolves export templates under its data path, which honours
# XDG_DATA_HOME. Pinning that inside our own versioned cache keeps the whole
# toolchain self-contained instead of writing into $HOME/.local/share.
GODOT_DATA_DIR="${CACHE_ROOT}/godot-data"
TEMPLATE_DIR="${GODOT_DATA_DIR}/godot/export_templates/${GODOT_TEMPLATE_DIR_VERSION}"

# Exported so every Godot invocation (tests, run, build) finds the templates.
export XDG_DATA_HOME="${GODOT_DATA_DIR}"
export GODOT_BIN
export TEMPLATE_DIR
